#!/usr/bin/env python3
# Apply a one-click look, e.g. `lennox-look neon`. Without a name: list them.
import os
import sys

sys.path.insert(0, os.path.expanduser("~/.local/share/lennox/python"))
from lennox import apply, settings  # noqa: E402

if len(sys.argv) != 2 or sys.argv[1] not in settings.LOOKS:
    print("usage: lennox-look NAME\n")
    for name, (title, desc, _values) in settings.LOOKS.items():
        print(f"  {name:<12} {title}: {desc}")
    sys.exit(0 if len(sys.argv) == 1 else 2)
name = sys.argv[1]
parts = settings.apply_look(name)
apply.main(parts)
print(f"{settings.LOOKS[name][0]} look applied")
