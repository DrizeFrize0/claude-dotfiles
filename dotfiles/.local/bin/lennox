#!/usr/bin/env bash
# Lennox command line. Run `lennox` for help.
export PATH="$HOME/.local/bin:$PATH"

cmd="${1:-help}"
shift 2>/dev/null
case "$cmd" in
    settings)  exec lennox-settings "$@" ;;
    wallpaper) exec lennox-wallpaper "$@" ;;
    theme)     exec lennox-theme "$@" ;;
    bar)       exec lennox-bar "$@" ;;
    dock)      exec lennox-dock "$@" ;;
    update)    exec lennox-update "$@" ;;
    doctor)    exec lennox-doctor "$@" ;;
    gpu)       exec lennox-gpu "$@" ;;
    get)       exec lennox-get "$@" ;;
    set)       exec lennox-set "$@" ;;
    apply)     exec lennox-apply "$@" ;;
    keys)      exec lennox-menu keybinds ;;
    upgrade)   exec lennox-update-dotfiles "$@" ;;
    version)   cat "$HOME/.config/lennox/version" 2>/dev/null || echo unknown ;;
    help|-h|--help)
        cat <<'HELP'
Lennox - Hyprland for Arch, in the spirit of ML4W

  lennox settings            open Lennox Settings (also SUPER + I)
  lennox wallpaper IMAGE     set a wallpaper and re-color everything (--random)
  lennox theme toggle        dark / light mode
  lennox bar style NAME      modern | glass | minimal
  lennox dock toggle         show / hide the dock
  lennox update              update system, drivers, AUR apps and Flatpaks now
  lennox doctor              check drivers, sound, mic, touchpad, updates
  lennox gpu status          NVIDIA / Intel status   (gpu run APP: run on NVIDIA)
  lennox get KEY / set KEY V read or change a setting, e.g. lennox set bar.style glass
  lennox keys                searchable list of all keybindings
  lennox upgrade             update Lennox itself from its git repository
  lennox version
HELP
        ;;
    *) echo "lennox: unknown command '$cmd' (try: lennox help)" >&2; exit 2 ;;
esac
