#!/usr/bin/env python3
# Change a Lennox setting and apply it, e.g. `lennox-set bar.style glass`.
# Usage: lennox-set section.key value [--no-apply]
import os
import sys

sys.path.insert(0, os.path.expanduser("~/.local/share/lennox/python"))
from lennox import apply, settings  # noqa: E402

args = [a for a in sys.argv[1:] if a != "--no-apply"]
if len(args) != 2:
    print("usage: lennox-set section.key value [--no-apply]", file=sys.stderr)
    sys.exit(2)
path, text = args
try:
    value = settings.parse_value(path, text)
    saved = settings.set_value(path, value)
except KeyError:
    print(f"lennox-set: unknown setting {path}", file=sys.stderr)
    sys.exit(1)
except ValueError as e:
    print(f"lennox-set: {e}", file=sys.stderr)
    sys.exit(1)
if saved != value:
    print(f"lennox-set: {path} adjusted to {saved}", file=sys.stderr)
if "--no-apply" not in sys.argv:
    parts = settings.parts_for(path)
    if parts:
        apply.main(parts)
