#!/usr/bin/env python3
# Print a Lennox setting, e.g. `lennox-get bar.style`. Booleans print as true/false.
import os
import sys

sys.path.insert(0, os.path.expanduser("~/.local/share/lennox/python"))
from lennox import settings  # noqa: E402

if len(sys.argv) != 2:
    print("usage: lennox-get section.key", file=sys.stderr)
    sys.exit(2)
try:
    value = settings.get(settings.load(), sys.argv[1])
except KeyError:
    print(f"lennox-get: unknown setting {sys.argv[1]}", file=sys.stderr)
    sys.exit(1)
if isinstance(value, bool):
    value = "true" if value else "false"
print(value)
