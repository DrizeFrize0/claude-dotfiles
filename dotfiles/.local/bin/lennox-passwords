#!/usr/bin/env bash
# Passwords: Bitwarden everywhere.
# Bitwarden (end-to-end encrypted, open source, audited) keeps the vault;
# rbw keeps a locked local copy so the filler is fast; rofi-rbw types.
#   lennox-passwords fill            pick a login and type it into the focused app (SUPER + P)
#   lennox-passwords setup EMAIL [us|eu]   connect this laptop (opens a terminal for the sign-in)
#   lennox-passwords status          JSON: set up? email? region? unlocked?
#   lennox-passwords lock            lock the vault now
#   lennox-passwords exports         list exported password files left in Downloads
#   lennox-passwords clean-exports   securely delete them
export PATH="$HOME/.local/bin:$PATH"

DOWNLOADS="$(xdg-user-dir DOWNLOAD 2>/dev/null || echo "$HOME/Downloads")"
[[ -d "$DOWNLOADS" ]] || DOWNLOADS="$HOME/Downloads"

notify() { notify-send -a Lennox -i dialog-password -t 4000 "$1" "${2:-}"; }

email() { rbw config show 2>/dev/null | jq -r '.email // empty' 2>/dev/null; }

export_files() {
    # Password exports from Chrome/Google, Bitwarden, LastPass, 1Password,
    # Dashlane, NordPass, Safari...: CSV files whose header has a password
    # column, plus 1Password / Bitwarden export formats. Newest first.
    local f header
    [[ -d "$DOWNLOADS" ]] || return 0
    while IFS= read -r -d '' f; do
        case "${f,,}" in
            *.1pux|*bitwarden_export*.json|*bitwarden_encrypted_export*.json)
                printf '%s\n' "$f" ;;
            *.csv)
                header="$(head -c 4096 -- "$f" 2>/dev/null | head -n1 | tr '[:upper:]' '[:lower:]')"
                [[ "$header" == *password* ]] && printf '%s\n' "$f" ;;
        esac
    done < <(find "$DOWNLOADS" -maxdepth 2 -type f \( -iname '*.csv' -o -iname '*.1pux' -o -iname '*.json' \) -print0 2>/dev/null)
}

case "${1:-fill}" in
    fill)
        if ! command -v rbw >/dev/null || ! command -v rofi-rbw >/dev/null; then
            notify "Passwords aren't installed" "Run: lennox upgrade"
            exit 1
        fi
        if [[ -z "$(email)" ]]; then
            notify "Set up passwords first" "Lennox Settings > Passwords connects your Bitwarden account."
            setsid -f lennox-settings --page passwords >/dev/null 2>&1
            exit 0
        fi
        if ! rbw unlocked >/dev/null 2>&1; then
            # Asks for your master password in a small dialog
            rbw unlock || exit 0
        fi
        # The Lennox list menu look (rofi-rbw doesn't expand ~, so pass the path)
        rofi-rbw --selector rofi \
            --selector-args "-config $HOME/.config/rofi/compact.rasi -theme-str 'window { width: 46em; }'"
        ;;

    setup)
        addr="${2:-}"
        region="${3:-us}"
        [[ "$addr" =~ ^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$ ]] || { echo "usage: lennox-passwords setup EMAIL [us|eu]" >&2; exit 2; }
        rbw config set email "$addr"
        # rbw works out the other server addresses from base_url
        for key in base_url identity_url ui_url notifications_url; do rbw config unset "$key" >/dev/null 2>&1; done
        if [[ "$region" == "eu" ]]; then
            rbw config set base_url "https://api.bitwarden.eu"
            vault="https://vault.bitwarden.eu"
        else
            vault="https://vault.bitwarden.com"
        fi
        rbw config set lock_timeout 900        # locks itself after 15 minutes
        # A small password dialog instead of a terminal prompt
        for pe in pinentry-gnome3 pinentry-gtk; do
            command -v "$pe" >/dev/null && { rbw config set pinentry "$pe"; break; }
        done
        # The official server wants each command line device registered once
        # with your personal API key, then a normal sign-in.
        guide="$(cat <<EOF
Connecting this laptop to Bitwarden ($addr)

Step 1 of 2: register this laptop (only once).
  Bitwarden asks the command line for your *personal API key*:
  open $vault > Settings > Security > Keys > View API key,
  then copy client_id and client_secret into the boxes that pop up.

EOF
)"
        script="printf '%s\n' \"\$GUIDE\"; rbw register && { echo; echo 'Step 2 of 2: sign in with your master password.'; rbw login && rbw sync && { echo; echo 'Done! Press SUPER + P in any app to fill a password.'; notify-send -a Lennox -i dialog-password 'Passwords ready' 'SUPER + P fills a login in any app.'; }; }; echo; read -rp 'Press Enter to close.' _"
        GUIDE="$guide" setsid -f kitty --class lennox-floating --title "Connect Bitwarden" bash -c "$script" >/dev/null 2>&1
        ;;

    status)
        addr="$(email)"
        region=us
        rbw config show 2>/dev/null | jq -e '(.base_url // "") | test("bitwarden\\.eu")' >/dev/null 2>&1 && region=eu
        unlocked=false
        [[ -n "$addr" ]] && rbw unlocked >/dev/null 2>&1 && unlocked=true
        installed=false
        command -v rbw >/dev/null && command -v rofi-rbw >/dev/null && installed=true
        jq -cn --arg email "$addr" --argjson unlocked "$unlocked" --argjson installed "$installed" --arg region "$region" \
            '{installed: $installed, email: $email, region: $region, unlocked: $unlocked}'
        ;;

    lock)
        command -v rbw >/dev/null && rbw unlocked >/dev/null 2>&1 && rbw lock >/dev/null 2>&1
        exit 0
        ;;

    exports)
        export_files
        ;;

    clean-exports)
        mapfile -t files < <(export_files)
        if (( ${#files[@]} == 0 )); then
            echo "No exported password files found in $DOWNLOADS"
            exit 0
        fi
        for f in "${files[@]}"; do
            # Overwrite before deleting, so the passwords can't be recovered
            shred -u -z -- "$f" 2>/dev/null || rm -f -- "$f"
            echo "Deleted: ${f##*/}"
        done
        notify "Exported passwords deleted" "${#files[@]} file(s) securely removed from Downloads."
        ;;

    *)
        echo "usage: lennox-passwords fill | setup EMAIL [us|eu] | status | lock | exports | clean-exports" >&2
        exit 2
        ;;
esac
