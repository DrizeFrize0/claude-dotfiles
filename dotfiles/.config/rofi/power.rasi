/* Lennox power menu (SUPER + ESC): a row of big glass buttons. */

@import "~/.config/rofi/shared.rasi"

configuration {
    show-icons: false;
    font: "Inter SemiBold 11";
}

window {
    width:             44em;
}

mainbox {
    padding:           20px;
    spacing:           16px;
    children:          [ "message", "listview" ];
    background-color:  transparent;
}

message {
    background-color:  transparent;
    padding:           0;
}

textbox {
    horizontal-align:  0.5;
    text-color:        @on-surface-variant;
}

listview {
    columns:           5;
    lines:             1;
    spacing:           12px;
    cycle:             true;
    dynamic:           true;
    scrollbar:         false;
    layout:            vertical;
    fixed-columns:     true;
    background-color:  transparent;
}

element {
    padding:           20px 6px 16px 6px;
    border:            1px;
    border-color:      @outline-soft;
    border-radius:     22px;
    background-color:  @tile;
}

element selected.normal {
    border-color:      @primary;
    background-color:  @primary;
    text-color:        @on-primary;
}

element-text {
    horizontal-align:  0.5;
    vertical-align:    0.5;
}
