/* Lennox compact menu: clipboard, Wi-Fi, keybinds, screenshots, bar style.
 * Drops down from the top of the screen, like the ML4W menus. */

@import "~/.config/rofi/shared.rasi"

configuration {
    show-icons: false;
}

window {
    width:             34em;
    y-offset:          1.5em;
    location:          north;
    anchor:            north;
    transparency:      "real";
    fullscreen:        false;
    enabled:           true;
    cursor:            "default";
    border:            @border-width;
    border-color:      @primary;
    border-radius:     @border-radius;
    background-color:  @background;
}

mainbox {
    enabled:           true;
    spacing:           0em;
    padding:           0em;
    orientation:       vertical;
    children:          [ "inputbar", "message", "listview" ];
    background-color:  transparent;
}

inputbar {
    enabled:           true;
    padding:           0.6em;
    margin:            0.8em 0.8em 0em 0.8em;
    border-radius:     2em;
    children:          [ "prompt", "entry" ];
    background-color:  @surface;
}

prompt {
    padding:           0.5em 0.6em 0.5em 0.8em;
    text-color:        @primary;
    background-color:  transparent;
}

entry {
    padding:           0.5em;
    text-color:        @on-surface;
    cursor:            text;
    placeholder:       "Search";
    placeholder-color: inherit;
    background-color:  transparent;
}

message {
    margin:            0.6em 1em 0em 1em;
    background-color:  transparent;
}

textbox {
    text-color:        @on-surface;
    background-color:  transparent;
    horizontal-align:  0.0;
}

listview {
    padding:           0.8em;
    spacing:           0.2em;
    columns:           1;
    lines:             10;
    cycle:             true;
    dynamic:           true;
    scrollbar:         false;
    layout:            vertical;
    fixed-height:      false;
    background-color:  transparent;
}

element {
    padding:           0.55em 0.9em;
    cursor:            pointer;
    background-color:  transparent;
    text-color:        @on-surface;
}

element selected.normal {
    background-color:  @primary;
    text-color:        @on-primary;
    border-radius:     1.2em;
}

element normal.normal,
element alternate.normal {
    background-color:  transparent;
    text-color:        @on-surface;
}

element normal.active,
element alternate.active {
    text-color:        @primary;
    background-color:  transparent;
}

element-text {
    vertical-align:    0.5;
    cursor:            inherit;
    background-color:  transparent;
    text-color:        inherit;
}

element-icon {
    size:              1.4em;
    background-color:  transparent;
}
