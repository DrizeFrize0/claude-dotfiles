# -----------------------------------------------------
# Prompt: Oh My Posh (the ML4W "zen" style); plain fallback without it
# -----------------------------------------------------
if command -v oh-my-posh >/dev/null; then
    eval "$(oh-my-posh init zsh --config "$HOME/.config/ohmyposh/lennox.toml")"
else
    PROMPT='%F{cyan}%~%f
%(?.%F{magenta}.%F{red})❯%f '
fi
