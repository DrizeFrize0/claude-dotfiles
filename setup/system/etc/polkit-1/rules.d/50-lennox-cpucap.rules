// Lennox fan and noise profiles: cap the processor without a password.
// Only this one root-owned script, and only for people in the wheel group
// on the computer itself.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/local/bin/lennox-cpucap" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
